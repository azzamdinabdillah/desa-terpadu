# =============================================================================
# Environment Variables untuk Docker Production
# Salin file ini: cp .env.docker .env.docker.local
# Jangan commit file .env.docker.local ke git!
# =============================================================================

# -------------------------------------------------------
# Application
# -------------------------------------------------------
APP_NAME="Desa Terpadu"
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_KEY_BARU_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_PORT=80
LOG_LEVEL=warning

# -------------------------------------------------------
# Database MySQL
# -------------------------------------------------------
DB_DATABASE=desa_terpadu
DB_USERNAME=desa_user
DB_PASSWORD=GANTI_PASSWORD_KUAT_DISINI
DB_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_KUAT_DISINI
DB_EXTERNAL_PORT=3306

# -------------------------------------------------------
# Redis
# -------------------------------------------------------
REDIS_PASSWORD=GANTI_REDIS_PASSWORD_DISINI
REDIS_EXTERNAL_PORT=6379

# -------------------------------------------------------
# Session & Cache
# -------------------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database

# -------------------------------------------------------
# Mail (Gmail / SMTP)
# -------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=youremail@gmail.com
MAIL_FROM_NAME="Desa Terpadu"
